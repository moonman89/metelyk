# Create project: https://console.firebase.google.com → Add project "metelyk-shop"
# Project settings → Your apps → Web app → copy config values here

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=metelyk-shop.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=metelyk-shop
VITE_FIREBASE_STORAGE_BUCKET=metelyk-shop.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Tea guide: openai (ChatGPT API via Cloud Function) or gemini
VITE_TEA_AI_PROVIDER=openai

# Only if VITE_TEA_AI_PROVIDER=gemini — Firebase AI Logic in Console
VITE_FIREBASE_AI_MODEL=gemini-2.0-flash
