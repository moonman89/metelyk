{
  "name": "metelyk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "firebase:init": "firebase projects:create metelyk-shop --display-name \"Metelyk Tea Shop\" || true",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage",
    "firebase:deploy:functions": "node scripts/sync-catalog-to-functions.mjs && firebase deploy --only functions",
    "firebase:deploy:assistant": "npm run build && firebase deploy --only hosting,functions"
  },
  "dependencies": {
    "firebase": "^11.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
